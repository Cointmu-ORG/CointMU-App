{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "src/main/**/*",
    "src/bridge/**/*",
    "scripts/**/*.ts",
    "electron.vite.config.ts",
    "vitest.config.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "moduleResolution": "bundler",
    "module": "ESNext",
    "outDir": "./out/main",
    "rootDir": ".",
    "types": ["node"]
  }
}

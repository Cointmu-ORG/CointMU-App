{
  "name": "cointmu-desktop",
  "productName": "CointMU",
  "version": "1.8.0",
  "codename": "Orion",
  "description": "CointMU Desktop Client - Proof of Work Blockchain Node Manager",
  "main": "./out/main/index.js",
  "author": "CointMU",
  "license": "MIT",
  "homepage": "https://github.com/Cointmu-ORG/CointMU-App",
  "packageManager": "npm@12.2.0",
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "^12.2.0",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": "^24.15.0",
      "onFail": "warn"
    }
  },
  "scripts": {
    "dev": "electron-vite dev",
    "prebuild": "node update-build.js",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && npm run build:geth-supervisor && electron-builder --win",
    "build:geth-supervisor": "go -C native/geth-supervisor build -trimpath -buildvcs=false -o ../../resources/bin/win/geth-supervisor.exe .",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "i18n:audit": "tsx scripts/sync-i18n.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "npm run lint:code && npm run lint:fsd",
    "lint:code": "oxlint",
    "lint:fsd": "steiger ./src/renderer/src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preversion": "npm run build",
    "version": "node scripts/sync-release-files.js"
  },
  "dependencies": {
    "@sentry/core": "11.8.0",
    "@sentry/electron": "^8.3.0",
    "boring-avatars": "^2.0.4",
    "date-fns": "^4.4.0",
    "electron-log": "^5.4.4",
    "electron-store": "^12.0.0",
    "electron-updater": "^6.8.11",
    "ethers": "^6.17.0",
    "i18next": "^27.1.0",
    "lucide-react": "^1.71.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.1",
    "react-router-dom": "^7.18.5",
    "ws": "^8.22.2",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron-toolkit/utils": "^4.0.0",
    "@feature-sliced/steiger-plugin": "0.8.2",
    "@tailwindcss/vite": "^4.3.5",
    "@types/chrome": "^0.3.7",
    "@types/detect-port": "^2.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.2.1",
    "archiver": "^8.0.0",
    "detect-port": "^2.0.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "oxc-parser": "0.157.0",
    "oxlint": "1.92.0",
    "prettier": "3.9.10",
    "steiger": "0.9.0",
    "tailwindcss": "^4.3.0",
    "tsx": "4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "esbuild": false,
    "electron-winstaller": false
  }
}

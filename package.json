{
  "name": "cointmu-desktop",
  "productName": "CointMU",
  "version": "1.6.16",
  "codename": "Kitsune",
  "description": "CointMU Desktop Client - Proof of Work Blockchain Node Manager",
  "main": "./out/main/index.js",
  "author": "CointMU",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "prebuild": "node update-build.js",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "i18n:audit": "tsx scripts/sync-i18n.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "npm run lint:code && npm run lint:fsd",
    "lint:code": "oxlint",
    "lint:fsd": "steiger ./src/renderer/src",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "boring-avatars": "^2.0.4",
    "crypto": "^1.0.1",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.7",
    "electron-store": "^12.0.0",
    "electron-updater": "^6.8.9",
    "ethers": "^6.17.0",
    "i18next": "^26.4.4",
    "lucide-react": "^1.56.0",
    "ms": "^2.1.3",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.16",
    "react-router-dom": "^7.18.4",
    "ws": "^8.22.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^3.0.0",
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron-toolkit/utils": "^4.0.0",
    "@feature-sliced/steiger-plugin": "0.8.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.3.5",
    "@types/detect-port": "^2.0.0",
    "@types/ms": "^2.1.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.2.0",
    "detect-port": "^2.0.0",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "oxlint": "1.88.0",
    "prettier": "3.9.10",
    "steiger": "0.7.0",
    "tailwindcss": "^4.3.0",
    "tsx": "4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}

# Read at runtime by the main process (dev only: a packaged app has no .env).
# The values are the code defaults; the network id must match the genesis
# chainId (1912) or the node never finds a peer.
GETH_NETWORK_ID=1912
GETH_HTTP_PORT=8585
GETH_LOG_VERBOSITY=3
# Error reporting (read at build time by electron-vite, baked into the main
# bundle). Leave MAIN_VITE_TELEMETRY_DSN empty to build without reporting.
# DSN must be https. PINS is a comma-separated list of base64 SHA-256 SPKI
# pins of the collector key (current,next during a rotation), printed by:
#   openssl x509 -in cert.pem -pubkey -noout | openssl pkey -pubin -outform der | openssl dgst -sha256 -binary | base64
MAIN_VITE_TELEMETRY_DSN=
MAIN_VITE_TELEMETRY_PINS=
# Bootnode (read at build time, baked into the main bundle). Leave empty to use
# the built-in campus bootnode. Format: enode://<128 hex node id>@<host>:<port>
# (on the server: geth attach --exec admin.nodeInfo.enode, with the LAN IP).
MAIN_VITE_BOOTNODE_ENODE=

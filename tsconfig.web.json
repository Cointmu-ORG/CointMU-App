{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/renderer/src/**/*",
    "src/renderer/src/**/*.tsx",
    "src/renderer/src/**/*.json",
    "src/preload/*.d.ts",
    "src/bridge/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "outDir": "./out/renderer",
    "rootDir": "./src",
    "paths": {
      "@/*": ["./src/renderer/src/*"],
      "@bridge/*": ["./src/bridge/*"]
    }
  }
}
